{
  "name": "holi-react-native-setup",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "holi-apps/*",
      "packages/*",
      "core",
      "e2e/*"
    ]
  },
  "resolutions": {
    "**/ts-invariant": "0.9.4",
    "**/tslib": "2.3.1"
  },
  "scripts": {
    "mobile:dev": "yarn workspace @holi/mobile dev",
    "mobile:build_all": "yarn workspace @holi/mobile build_all",
    "mobile:build_android": "yarn workspace @holi/mobile build_android",
    "mobile:build_ios": "yarn workspace @holi/mobile build_ios",
    "mobile:build_ios_sim": "yarn workspace @holi/mobile build_ios_sim",
    "mobile:e2e:ios": "yarn workspace @holi/e2e-mobile codeceptjs:ios",
    "mobile:e2e:android": "yarn workspace @holi/e2e-mobile codeceptjs:android",
    "web:dev": "yarn workspace @holi/web dev",
    "web:build": "yarn workspace @holi/web build",
    "web:start": "yarn workspace @holi/web start",
    "web:e2e": "yarn workspace @holi/e2e-web codeceptjs",
    "web:e2e:headless": "yarn workspace @holi/e2e-web codeceptjs:headless",
    "mock-api:dev": "yarn workspace @holi/mock-api dev",
    "ui:generate-style-vars": "yarn workspace @holi/ui run generate-style-vars",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "prepare": "husky install",
    "clean": "yarn workspaces run clean",
    "clean:all": "yarn workspaces run clean:all && rimraf node_modules"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^3.2.0",
    "@typescript-eslint/eslint-plugin": "^5.14.0",
    "@typescript-eslint/parser": "^5.14.0",
    "eslint": "^8.10.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.29.3",
    "eslint-plugin-react-native": "^4.0.0",
    "husky": "^7.0.4",
    "prettier": "^2.5.1",
    "turbo": "^1.1.6"
  },
  "packageManager": "yarn@1.22.17"
}
