{
  "name": "holi-frontends",
  "private": true,
  "workspaces": {
    "nohoist": [
      "holi-bricks"
    ],
    "packages": [
      "apps/*",
      "holi-apps/*",
      "packages/*",
      "holi-bricks",
      "core",
      "e2e/mobile",
      "e2e/web"
    ],
    "installConfigs": {
      "hoistingLimits": [
        "**/jest-offline"
      ]
    }
  },
  "scripts": {
    "mobile:dev": "yarn workspace @holi/mobile dev",
    "mobile:dev_client": "yarn workspace @holi/mobile dev_client",
    "mobile:preview": "yarn workspace @holi/mobile preview",
    "mobile:build_all": "yarn workspace @holi/mobile build_all",
    "mobile:build_android": "yarn workspace @holi/mobile build_android",
    "mobile:build_android_preview": "yarn workspace @holi/mobile build_android_preview",
    "mobile:build_ios": "yarn workspace @holi/mobile build_ios",
    "mobile:build_ios_sim": "yarn workspace @holi/mobile build_ios_sim",
    "mobile:build_ios_dev": "yarn workspace @holi/mobile build_ios_dev",
    "mobile:build_ios_dev_sim": "yarn workspace @holi/mobile build_ios_dev_sim",
    "storybook:dev": "yarn workspace @holi/storybook dev",
    "storybook:build": "yarn workspace @holi/storybook build",
    "bricks:publish": "yarn workspace holi-bricks publish-library",
    "storybook:publish": "yarn workspace @holi/storybook publish-library",
    "web:dev": "yarn workspace @holi/web dev",
    "web:build": "yarn workspace @holi/web build",
    "web:start": "yarn workspace @holi/web start",
    "holi-bricks:web": "yarn workspace holi-bricks web",
    "check-types": "tsc --noEmit",
    "lint": "yarn workspaces foreach --parallel --since=main run lint",
    "lint_all": "yarn workspaces foreach --parallel --all run lint",
    "format": "yarn biome format --write",
    "format:check": "yarn biome format",
    "clean": "yarn workspaces foreach -A run clean",
    "clean:all": "yarn workspaces foreach -A run clean:all && npx rimraf node_modules",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:update": "jest -u",
    "test:watch": "jest --watch",
    "test:watchAll": "jest --watchAll",
    "e2e:android": "yarn workspace @holi/e2e-mobile test:android",
    "e2e:android:smoke": "yarn workspace @holi/e2e-mobile test:android:smoke",
    "e2e:ios": "yarn workspace @holi/e2e-mobile test:ios",
    "e2e:ios:smoke": "yarn workspace @holi/e2e-mobile test:ios:smoke",
    "schema:watch": "graphql-codegen --watch",
    "schema:generate": "graphql-codegen",
    "i18n:upload": "./scripts/upload_translations.sh",
    "i18n:download": "localazy download -r $LOCALAZY_API_KEY_READ -q"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@faker-js/faker": "^8.1.0",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.6",
    "@graphql-codegen/typescript-operations": "^4.2.0",
    "@graphql-codegen/typescript-react-apollo": "^4.3.0",
    "@localazy/cli": "^2.0.8",
    "@parcel/watcher": "^2.4.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "12.7.2",
    "@types/jest": "^29.5.13",
    "@types/jest-when": "^3.5.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^13.0.0",
    "eslint": "^8.33.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-native": "^4.1.0",
    "graphql-tag": "^2.12.6",
    "jest": "^29.7.0",
    "jest-expo": "^53.0.5",
    "jest-offline": "^1.0.1",
    "jest-when": "^3.6.0",
    "node-gyp": "^10.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "packageManager": "yarn@4.7.0",
  "expo-yarn-workspaces": {
    "symlinks": [
      "expo-constants"
    ]
  },
  "dependencies": {
    "expo": "^53.0.9",
    "react-native-unistyles": "^3.0.0-rc.4",
    "react-native-web": "^0.20.0"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "resolutions": {
    "metro": "0.82.0",
    "metro-resolver": "0.82.0",
    "metro-config": "0.82.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "mime-db": "1.53.0"
  }
}
