{
  "name": "holi-frontends",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "holi-apps/*",
      "packages/*",
      "core",
      "e2e/mobile"
    ]
  },
  "resolutions": {
    "**/ts-invariant": "0.9.4",
    "**/tslib": "2.3.1",
    "**/@storybook/react-docgen-typescript-plugin": "1.0.1",
    "**/@types/react": "17.0.2"
  },
  "scripts": {
    "mobile:dev": "yarn workspace @holi/mobile dev",
    "mobile:build_all": "yarn workspace @holi/mobile build_all",
    "mobile:build_android": "yarn workspace @holi/mobile build_android",
    "mobile:build_android_apk": "yarn workspace @holi/mobile build_android_apk",
    "mobile:build_ios": "yarn workspace @holi/mobile build_ios",
    "mobile:build_ios_sim": "yarn workspace @holi/mobile build_ios_sim",
    "web:dev": "yarn workspace @holi/web dev",
    "storybook:dev": "yarn workspace @holi/storybook dev",
    "storybook:build": "yarn workspace @holi/storybook build",
    "web:build": "yarn workspace @holi/web build",
    "web:start": "yarn workspace @holi/web start",
    "ui:generate-style-vars": "yarn workspace @holi/ui run generate-style-vars",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "prepare": "husky install",
    "clean": "yarn workspaces run clean",
    "clean:all": "yarn workspaces run clean:all && rimraf node_modules",
    "test": "jest",
    "test:update": "jest -u",
    "test:watch": "jest --watch",
    "test:watchAll": "jest --watchAll",
    "e2e:android": "yarn workspace @holi/e2e-mobile test:android",
    "e2e:ios": "yarn workspace @holi/e2e-mobile test:ios"
  },
  "devDependencies": {
    "@faker-js/faker": "^7.3.0",
    "@testing-library/react-native": "^9.1.0",
    "@trivago/prettier-plugin-sort-imports": "^3.2.0",
    "@types/jest": "^28.1.1",
    "@types/react-test-renderer": "17.0.2",
    "@typescript-eslint/eslint-plugin": "^5.14.0",
    "@typescript-eslint/parser": "^5.14.0",
    "babel-jest": "^28.1.1",
    "eslint": "^8.10.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.29.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.0.0",
    "husky": "^7.0.4",
    "jest": "^28.1.1",
    "jest-expo": "^45.0.1",
    "prettier": "^2.5.1",
    "react-test-renderer": "17.0.2",
    "turbo": "^1.1.6"
  },
  "packageManager": "yarn@1.22.17"
}
