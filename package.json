    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.29.3",
    "eslint-plugin-react-native": "^4.0.0",
    "husky": "^7.0.4",
    "prettier": "^2.5.1",
    "turbo": "^1.1.6"
