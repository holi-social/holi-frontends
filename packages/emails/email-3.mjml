<mjml>
	<mj-head>
		<mj-raw>
    	<meta name="format-detection" content="date=no" />
    	<meta name="format-detection" content="address=no" />
    	<meta name="format-detection" content="telephone=no" />
    	<meta name="x-apple-disable-message-reformatting" />
    </mj-raw>

    <mj-style inline="inline">
      .rounded table {
        border-collapse: separate;
      }

      .box {
      		background-color: transparent !important;
      }

      .box > table {
      		border: 1px solid #bdbcbc;
          border-radius: 24px;
      		border-collapse: separate;
      }

      .grid > table {
        margin-left: -8px;
        margin-right: -8px;
      }
    </mj-style>
    <mj-attributes>
    	<mj-all font-family="Trebuchet MS, Helvetica, sans-serif" />
      <mj-text font-size="16px" line-height="1.4" padding="0" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-title>{{subject}}</mj-title>
  </mj-head> 
  <mj-body background-color="#ffffff">
    
    <!-- HEADER -->  
    <mj-section padding-bottom="48px">
      <mj-column padding="24px" padding-top="64px" background-color="#f5f5f5" border-radius="14px">
        <mj-image align="left" padding="0px" width="55px" height="24px" src="https://ik.imagekit.io/holi/holi_logo_ajPMRkTXG.png" />
      </mj-column>
    </mj-section>

    <!-- BODY -->

		<!-- GREETING -->
    <mj-section padding-bottom="32px">
      <mj-column>
        <mj-text font-size="22px" line-height="120%" padding-bottom="16px">Hi {{subscriber.firstName}}!</mj-text>
        <mj-text padding-bottom="16px">
          This is our last email in this intro-to-holi series. We hope you liked it.
        </mj-text>
        <mj-text>
          For more inspiration, you can always check out the holi home feed or get
          in touch with our Community Team.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper css-class="box" background-color="#f5f5f5" padding="32px 24px 32px">
      
      <!-- INSIGHTS -->  
    	<mj-section padding-bottom="16px">
      	<mj-column>

        	<mj-text font-weight="600" padding-bottom="8px">
        		<img
              src="https://ik.imagekit.io/holi/Insight_sVbicetHp.png"
              style="width: 24px; height: 24px; margin-right: 8px; vertical-align: middle;"
            />
            Get into our "Insights"
        	</mj-text>
    
        	<mj-text>
        		Climate crisis, wars, populism—news can be hard to digest. Our
            'Insights' provide facts, perspectives, and actionable steps on
            current issues. Connect with other holi users, join polls, and see
            how meaningful conversations can inspire action!
        	</mj-text>
    

    		</mj-column>
    	</mj-section>
      <mj-section padding-bottom="16px" css-class="grid">
        <!-- INSIGHT CARDS -->
        <!-- {{#each data.recommendedInsights}} -->
      	<mj-column>

					<mj-button href="{{this.link}}" css-class="rounded" width="100%" padding="8px" inner-padding="8px" background-color="#ffffff" border-radius="16px" border="1px solid #bdbcbc">
            <img
              src="{{this.cover}}"
              style="
                width: 100%;
                min-width: 150px;
                height: 200px;
                border-radius: 8px;
                object-fit: cover;
                margin-bottom: 16px;
              "
            />
            <p
              style="
                margin: 0;
                padding:0 8px 8px;
                font-size: 16px;
                font-weight: 600;
                color: #262424;
                word-wrap: break-word;
              "
            >
              {{this.title}}
            </p>
          </mj-button>
        </mj-column>
        <!-- {{/each}} -->
      	<mj-column>

					<mj-button href="{{this.link}}" css-class="rounded" width="100%" padding="8px" inner-padding="8px" background-color="#ffffff" border-radius="16px" border="1px solid #bdbcbc">
            <img
              src="{{this.cover}}"
              style="
                width: 100%;
                min-width: 150px;
                height: 200px;
                border-radius: 8px;
                object-fit: cover;
                margin-bottom: 16px;
              "
            />
            <p
              style="
                margin: 0;
                padding:0 8px 8px;
                font-size: 16px;
                font-weight: 600;
                color: #262424;
                word-wrap: break-word;
              "
            >
              {{this.title}}
            </p>
          </mj-button>
        </mj-column>
      	<mj-column>

					<mj-button href="{{this.link}}" css-class="rounded" width="100%" padding="8px" inner-padding="8px" background-color="#ffffff" border-radius="16px" border="1px solid #bdbcbc">
            <img
              src="{{this.cover}}"
              style="
                width: 100%;
                min-width: 150px;
                height: 200px;
                border-radius: 8px;
                object-fit: cover;
                margin-bottom: 16px;
              "
            />
            <p
              style="
                margin: 0;
                padding:0 8px 8px;
                font-size: 16px;
                font-weight: 600;
                color: #262424;
                word-wrap: break-word;
              "
            >
              {{this.title}}
            </p>
          </mj-button>
        </mj-column>
        <!-- INSIGHT CARDS END -->
    	</mj-section>

      <mj-section padding-bottom="32px">
      	<mj-column>
        	<mj-raw>
              <a
                href="https://app.holi.social/en/insights?utm_source=welcome-email-series&utm_medium=email&utm_campaign=email3&userId={{subscriber.userId}}"
                style="
                  color: #5b60d6;
                  text-decoration: none;
                  font-weight: 500;
                  font-size: 16px;
                "
              >
                Explore more Insights →
              </a>
          </mj-raw>
        </mj-column>
      </mj-section>

      <!-- SPACES -->
      <mj-section padding-bottom="24px">
      	<mj-column>
        	<mj-text font-weight="600" padding-bottom="8px">
        		<img
              src="https://ik.imagekit.io/holi/Spaces_NPKywVfYd.png"
              style="width: 24px; height: 24px; margin-right: 8px; vertical-align: middle;"
            />
            Find Spaces you like
        	</mj-text>
        	<mj-text>
        		Here are some Spaces we think you might find interesting, based on
              your interests.
        	</mj-text>
    
        </mj-column>
      </mj-section>
      
      <mj-section padding-bottom="24px" css-class="grid">
        <!-- SPACE CARDS -->
        <!-- {{#each data.recommendedSpaces}} -->
      	<mj-column width="50%">
					<mj-button href="{{this.link}}" text-align="left" width="100%" padding="0 8px" inner-padding="8px" background-color="transparent">
            <table>
              <tr>
                <td>
                  <img
                    src="{{this.cover}}"
                    style="
                      width: 64px;
                      height: 64px;
                      border-radius: 8px;
                      border: 1px solid #262424;
                      object-fit: cover;
                      margin-right: 16px;
                    "
                  />
                </td>
                <td style="vertical-align: top;">
                  <h3
                      style="
                        margin: 0;
                        padding:2px 0px 4px;
                        font-size: 16px;
                        line-height: 1.4;
                        font-weight: 600;
                        color: #262424;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                      "
                    >
                      {{this.title}}
                  </h3>
                  <p
                    style="
                      margin: 0;
                      font-size: 13px;
                      line-height: 1.2;
                      color: #262424;
                      word-wrap: break-word;
                      display: -webkit-box;
                      -webkit-line-clamp: 2;
                      -webkit-box-orient: vertical;
                      overflow: hidden;
                      text-overflow: ellipsis;
                    "
                  >
                    {{this.goal}}
                  </p>
                </td>
              </tr>
            </table>
          </mj-button>
        </mj-column>
        <!-- {{/each}} -->
      	<mj-column width="50%">
					<mj-button href="{{this.link}}" text-align="left" width="100%" padding="0 8px" inner-padding="8px" background-color="transparent">
            <table>
              <tr>
                <td>
                  <img
                    src="{{this.cover}}"
                    style="
                      width: 64px;
                      height: 64px;
                      border-radius: 8px;
                      border: 1px solid #262424;
                      object-fit: cover;
                      margin-right: 16px;
                    "
                  />
                </td>
                <td style="vertical-align: top;">
                  <h3
                      style="
                        margin: 0;
                        padding:2px 0px 4px;
                        font-size: 16px;
                        line-height: 1.4;
                        font-weight: 600;
                        color: #262424;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                      "
                    >
                      {{this.title}}
                  </h3>
                  <p
                    style="
                      margin: 0;
                      font-size: 13px;
                      line-height: 1.2;
                      color: #262424;
                      word-wrap: break-word;
                      display: -webkit-box;
                      -webkit-line-clamp: 2;
                      -webkit-box-orient: vertical;
                      overflow: hidden;
                      text-overflow: ellipsis;
                    "
                  >
                    {{this.goal}}
                  </p>
                </td>
              </tr>
            </table>
          </mj-button>
        </mj-column>
      	<mj-column width="50%">
					<mj-button href="{{this.link}}" text-align="left" width="100%" padding="0 8px" inner-padding="8px" background-color="transparent">
            <table>
              <tr>
                <td>
                  <img
                    src="{{this.cover}}"
                    style="
                      width: 64px;
                      height: 64px;
                      border-radius: 8px;
                      border: 1px solid #262424;
                      object-fit: cover;
                      margin-right: 16px;
                    "
                  />
                </td>
                <td style="vertical-align: top;">
                  <h3
                      style="
                        margin: 0;
                        padding:2px 0px 4px;
                        font-size: 16px;
                        line-height: 1.4;
                        font-weight: 600;
                        color: #262424;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                      "
                    >
                      {{this.title}}
                  </h3>
                  <p
                    style="
                      margin: 0;
                      font-size: 13px;
                      line-height: 1.2;
                      color: #262424;
                      word-wrap: break-word;
                      display: -webkit-box;
                      -webkit-line-clamp: 2;
                      -webkit-box-orient: vertical;
                      overflow: hidden;
                      text-overflow: ellipsis;
                    "
                  >
                    {{this.goal}}
                  </p>
                </td>
              </tr>
            </table>
          </mj-button>
        </mj-column>
      	<mj-column width="50%">
					<mj-button href="{{this.link}}" text-align="left" width="100%" padding="0 8px" inner-padding="8px" background-color="transparent">
            <table>
              <tr>
                <td>
                  <img
                    src="{{this.cover}}"
                    style="
                      width: 64px;
                      height: 64px;
                      border-radius: 8px;
                      border: 1px solid #262424;
                      object-fit: cover;
                      margin-right: 16px;
                    "
                  />
                </td>
                <td style="vertical-align: top;">
                  <h3
                      style="
                        margin: 0;
                        padding:2px 0px 4px;
                        font-size: 16px;
                        line-height: 1.4;
                        font-weight: 600;
                        color: #262424;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                      "
                    >
                      {{this.title}}
                  </h3>
                  <p
                    style="
                      margin: 0;
                      font-size: 13px;
                      line-height: 1.2;
                      color: #262424;
                      word-wrap: break-word;
                      display: -webkit-box;
                      -webkit-line-clamp: 2;
                      -webkit-box-orient: vertical;
                      overflow: hidden;
                      text-overflow: ellipsis;
                    "
                  >
                    {{this.goal}}
                  </p>
                </td>
              </tr>
            </table>
          </mj-button>
        </mj-column>
        <!-- SPACE CARDS END -->
    	</mj-section>

      <mj-section>
      	<mj-column>
        	<mj-raw>
              <a
                href="https://app.holi.social/en/spaces?utm_source=welcome-email-series&utm_medium=email&utm_campaign=email3&userId={{subscriber.userId}}"
                style="
                  color: #5b60d6;
                  text-decoration: none;
                  font-weight: 500;
                  font-size: 16px;
                "
              >
                Explore more Spaces →
              </a>
          </mj-raw>
        </mj-column>
      </mj-section>
      
    </mj-wrapper>
    
  <!-- GOT QUESTIONS -->
  <mj-section padding-top="32px" padding-bottom="32px">
    <mj-column css-class="rounded" border="1px solid #bdbcbc" border-radius="24px" padding="24px">
     	<mj-text font-weight="600" padding-bottom="8px">
        Got questions?
      </mj-text>
        <mj-text padding-bottom="16px">
          Let us know if there are any open questions, ideas, or feedback you'd
          love to send us.
        </mj-text>
        <mj-text padding-bottom="12px">
        		<img
              src="https://ik.imagekit.io/holi/Spaces_NPKywVfYd.png"
              style="width: 24px; height: 24px; margin-right: 8px; vertical-align: middle;"
            />
            Visit our
            <a
              href="https://holi.social/en/help-center?utm_source=welcome-email-series&utm_medium=email&utm_campaign=email3&userId={{subscriber.userId}}"
              style="
                color: #5b60d6;
                text-decoration: none;
                font-weight: 500;
              "
            >
              Help Center</a
            >
        	</mj-text>
          <mj-text>
        		<img
              src="https://ik.imagekit.io/holi/chat-smile-2-line_9g-YYMJuW.png"
              style="width: 24px; height: 24px; margin-right: 8px; vertical-align: middle;"
            />
            Contact our
            <a
              href="mailto:support@holi.social"
              style="
                color: #5b60d6;
                text-decoration: none;
                font-weight: 500;
              "
            >
              Community team</a
            >
        	</mj-text>
    
     </mj-column>
    </mj-section>
    
    <!-- APP HERO -->  
    <mj-section padding-bottom="24px">
    	<mj-column>
      <!-- Volunteer Banner -->
        <mj-button
          href="https://app.holi.social/en/volunteering?utm_source=welcome-email-series&utm_medium=email&utm_campaign=email3&userId={{subscriber.userId}}"
          background-color="transparent"
        >
          <img
            src="https://ik.imagekit.io/holi/hero-volunteer-en_yyKzFUzAk.png"
            style="max-width: 100%"
          />
        </mj-button>

      </mj-column>
    </mj-section>
    
    <mj-section padding-bottom="16px">
    	<mj-column>
      	<mj-text align="center">
        	Access holi in your
          <a href="https://app.holi.social?utm_source=welcome-email-series&utm_medium=email&utm_campaign=email3&userId={{subscriber.userId}}" style="color: #262424">browser</a>
          or download the app
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-section padding-bottom="48px">
    	<mj-column>
        <mj-text align="center">
      	<a href="https://apps.apple.com/app/id6446693757" style="margin-right: 10px; text-decoration:none" >
             <img
              src="https://ik.imagekit.io/holi/badge_ios_mCeRPZd2R.png"
              style="height: 40px;"
            />
        </a>
        <a href="https://play.google.com/store/apps/details?id=social.holi.app&gl=DE&pli=1" style="text-decoration:none" >
             <img
              src="https://ik.imagekit.io/holi/badge_android_uR3kKVh5-.png"
              style="height: 40px;"
            />
          </a>
          </mj-text>
      </mj-column>
    </mj-section>

    <!-- BODY END -->
    
    <!-- FOOTER -->  
    <mj-section>
      <mj-column css-class="rounded" border-radius="32px 32px 0 0" border-bottom="none" border="1px solid #ebebeb" padding="24px 40px 0px 40px">
        <mj-text font-size="12px" padding="0" line-height="26px" align="center">
          You can always <a href="{{unsubscribe_url}}" style="color: #787777">unsubscribe</a> from this 3-part welcome series
							<br />
							Holi Moli GmbH • Eifflerstraße 43, 22769 Hamburg
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
