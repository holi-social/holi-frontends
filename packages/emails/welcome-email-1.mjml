<mjml>
	<mj-head>
		<mj-raw>
    	<meta name="format-detection" content="date=no" />
    	<meta name="format-detection" content="address=no" />
    	<meta name="format-detection" content="telephone=no" />
    	<meta name="x-apple-disable-message-reformatting" />
    </mj-raw>

    <mj-style inline="inline">
      .rounded table {
        border-collapse: separate;
      }

      .box {
      		background-color: transparent !important;
      }

      .box > table {
      		border: 1px solid #bdbcbc;
          border-radius: 24px;
      		border-collapse: separate;
      }

      .grid > table {
        margin-left: -8px;
        margin-right: -8px;
      }
    </mj-style>
    <mj-attributes>
    	<mj-all font-family="Trebuchet MS, Helvetica, sans-serif" />
      <mj-text font-size="16px" line-height="1.4" padding="0" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-title>{{subject}}</mj-title>
  </mj-head> 
  <mj-body background-color="#ffffff">
    
    <!-- HEADER -->  
    <mj-section padding-bottom="48px">
      <mj-column padding="24px" padding-top="64px" background-color="#f5f5f5" border-radius="14px">
        <mj-image align="left" padding="0px" width="55px" height="24px" src="https://ik.imagekit.io/holi/holi_logo_ajPMRkTXG.png" />
      </mj-column>
    </mj-section>

    <!-- BODY -->

		<!-- GREETING -->
    <mj-section padding-bottom="32px">
      <mj-column>
        <mj-text font-size="22px" line-height="120%" padding-bottom="16px">Hi {{subscriber.firstName}}!</mj-text>
        <mj-text padding-bottom="16px" font-weight="600">
           We're thrilled to welcome you to holi! 
        </mj-text>
        <mj-text padding-bottom="16px">
           Volunteer, share your knowledge, ask questions, network with amazing people, and connect to create positive impact. 
        </mj-text>
        <mj-text>
          We can empower each other and enable meaningful change. It's wonderful that you're a part of it! 🌍✨ 
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper css-class="box" background-color="#f5f5f5" padding="32px 24px 32px">
      
      
    	<mj-section padding-bottom="16px">
      	<mj-column>
        	<mj-text font-weight="600" padding-bottom="16px">
            Your first steps 
        	</mj-text>
    
        	<mj-text font-weight="600" padding-bottom="8px">
        		1. Show the community who you are
        	</mj-text>
          <mj-text padding-bottom="8px" padding-left="18px">
            Add your interests to see more of the content you care about. Plus, upload an image to truly connect with the community. 💛
          </mj-text>
          <mj-text padding-bottom="32px" padding-left="18px">
            <a href="{{data.user.profileLink}}?utm_source=welcome-email-series&utm_medium=email&utm_campaign=email1&userId={{subscriber.userId}}" 
              style="color: #5B60D6; text-decoration: none; font-weight: 500; display: inline-block;">
              Edit your profile →
            </a>
          </mj-text>

        	<mj-text font-weight="600" padding-bottom="8px">
        		2. Join the holi Community Space
        	</mj-text>
          <mj-text padding-bottom="8px" padding-left="18px">
            Meet change makers like you! The holi Community Space is a great starting point for your journey into holi.
          </mj-text>
          <mj-text padding-bottom="32px" padding-left="18px">
            <a href="https://app.holi.social/en/spaces/9a33a9e3-6077-4e30-91bd-f68eaa2942ff?tab=updates&utm_source=welcome-email-series&utm_medium=email&utm_campaign=email1&userId={{subscriber.userId}}"
              style="color: #5B60D6; text-decoration: none; font-weight: 500; display: inline-block;">
              Join our Community Space →
            </a>
          </mj-text>

          <mj-button padding="0" inner-padding="12px 24px" background-color="#fdfd80" color="#262424" border-radius="32px" border="1px solid #262424" font-weight="600">
            Log into holi
          </mj-button>
         
    		</mj-column>
    	</mj-section>
      
    </mj-wrapper>
    
  <!-- GOT QUESTIONS -->
  <mj-section padding-top="32px" padding-bottom="32px">
    <mj-column css-class="rounded" background-color="#EBECFF" border="1px solid #bdbcbc" border-radius="24px" padding="24px">
     	<mj-text font-weight="600" padding-bottom="8px">
        We're here for you!
      </mj-text>
        <mj-text padding-bottom="16px">
          Let us know if there are any open questions, ideas, or feedback you'd
          love to send us.
        </mj-text>
        <mj-text padding-bottom="12px">
        		<img
              src="https://ik.imagekit.io/holi/Spaces_NPKywVfYd.png"
              style="width: 24px; height: 24px; margin-right: 8px; vertical-align: middle;"
            />
            Visit our
            <a
              href="https://holi.social/en/help-center?utm_source=welcome-email-series&utm_medium=email&utm_campaign=email3&userId={{subscriber.userId}}"
              style="
                color: #5b60d6;
                text-decoration: none;
                font-weight: 500;
              "
            >
              Help Center</a
            >
        	</mj-text>
          <mj-text>
        		<img
              src="https://ik.imagekit.io/holi/chat-smile-2-line_9g-YYMJuW.png"
              style="width: 24px; height: 24px; margin-right: 8px; vertical-align: middle;"
            />
            Contact our
            <a
              href="mailto:support@holi.social"
              style="
                color: #5b60d6;
                text-decoration: none;
                font-weight: 500;
              "
            >
              Community team</a
            >
        	</mj-text>
    
     </mj-column>
    </mj-section>
    
  <!-- PART 2 -->
  <mj-section padding-bottom="32px">
    <mj-column css-class="rounded" border="1px solid #bdbcbc" border-radius="24px" padding="24px">
     	<mj-text font-weight="600" padding-bottom="12px">
        In part 2 of this email series ...
      </mj-text>
      <mj-text padding-bottom="16px">
        ... we'll take you deeper into what holi is all about and show you how our key features make it easy to discover volunteering opportunities tailored just for you.
      </mj-text>
      <mj-text padding-bottom="16px">
        We love having you with us!
      </mj-text>
      <mj-text>
        Your holi team 💛
      </mj-text>
      
     </mj-column>
    </mj-section>
    

    <!-- APP HERO -->  
    <mj-section padding-bottom="24px">
    	<mj-column>
      <!-- Volunteer Banner -->
        <mj-button
          href="https://app.holi.social/en/volunteering?utm_source=welcome-email-series&utm_medium=email&utm_campaign=email3&userId={{subscriber.userId}}"
          background-color="transparent"
        >
          <img
            src="https://ik.imagekit.io/holi/hero-volunteer-en_yyKzFUzAk.png"
            style="max-width: 100%"
          />
        </mj-button>

      </mj-column>
    </mj-section>
    
    <mj-section padding-bottom="16px">
    	<mj-column>
      	<mj-text align="center">
        	Access holi in your
          <a href="https://app.holi.social?utm_source=welcome-email-series&utm_medium=email&utm_campaign=email3&userId={{subscriber.userId}}" style="color: #262424">browser</a>
          or download the app
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-section padding-bottom="48px">
    	<mj-column>
        <mj-text align="center">
      	<a href="https://apps.apple.com/app/id6446693757" style="margin-right: 10px; text-decoration:none" >
             <img
              src="https://ik.imagekit.io/holi/badge_ios_mCeRPZd2R.png"
              style="height: 40px;"
            />
        </a>
        <a href="https://play.google.com/store/apps/details?id=social.holi.app&gl=DE&pli=1" style="text-decoration:none" >
             <img
              src="https://ik.imagekit.io/holi/badge_android_uR3kKVh5-.png"
              style="height: 40px;"
            />
          </a>
          </mj-text>
      </mj-column>
    </mj-section>

    <!-- BODY END -->
    
    <!-- FOOTER -->  
    <mj-section>
      <mj-column css-class="rounded" border-radius="32px 32px 0 0" border-bottom="none" border="1px solid #ebebeb" padding="24px 40px 0px 40px">
        <mj-text font-size="12px" padding="0" line-height="26px" align="center">
          You can always <a href="{{unsubscribe_url}}" style="color: #787777">unsubscribe</a> from this 3-part welcome series
							<br />
							Holi Moli GmbH • Eifflerstraße 43, 22769 Hamburg
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
