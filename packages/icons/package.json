{
  "name": "@holi/icons",
  "version": "1.0.0",
  "scripts": {
    "build": "yarn svgr -d ./src/generated ./assets && yarn format",
    "clean": "echo 'nothing to be done'",
    "clean:all": "yarn clean",
    "lint": "TIMING=1 eslint .",
    "format": "yarn workspace holi-frontends biome format --write packages/icons/src",
    "format:check": "yarn workspace holi-frontends biome format packages/icons/src"
  },
  "dependencies": {
    "eslint": "^8.33.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-native": "^4.1.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@svgr/cli": "8.0.1"
  }
}
