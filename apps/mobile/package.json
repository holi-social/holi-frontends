    "android": " npx expo run:android",
    "build_all": "npx --yes eas-cli build --platform all",
    "build_android": "npx --yes eas-cli build --platform android",
    "build_android_preview": "npx --yes eas-cli build --platform android --profile preview",
    "build_android_dev": "npx --yes eas-cli build --platform android --profile development",
    "build_ios": "npx --yes eas-cli build --platform ios",
    "build_ios_preview": "npx --yes eas-cli build --platform ios --profile preview",
    "build_ios_dev": "npx --yes eas-cli build --platform ios --profile development",
