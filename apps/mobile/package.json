    "clean:all": "yarn clean && npx rimraf node_modules",
    "dev": "npx expo start",
    "dev_client": "npx expo start --dev-client",
    "eas-build-pre-install": "corepack enable",
    "eject": "npx expo eject",
    "ios": "npx expo run:ios",
    "lint": "TIMING=1 eslint .",
    "preview": "npx expo start --no-dev --minify",
    "start": "npx expo start",
    "test": "echo 'unit testing goes here'"
  },
  "version": "1.0.1",
  "packageManager": "yarn@4.10.3",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
