{
  "cli": {
    "version": ">= 0.47.0"
  },
  "build": {
    "simulator": {
      "ios": {
        "simulator": true
      },
      "env": {
        "HOLI_API_URL": "https://staging.unified.apis.project-holi.org/graphql"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "HOLI_API_URL": "https://staging.unified.apis.project-holi.org/graphql"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "HOLI_API_URL": "https://staging.unified.apis.project-holi.org/graphql"
      }
    },
    "production": {
      "env": {
        "HOLI_API_URL": "https://production.unified.apis.project-holi.org/graphql",
        "KRATOS_BASE_URL": "https://auth.project-holi.org"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": ".holi-playstore_service-account.json",
        "track": "alpha",
        "changesNotSentForReview": "true"
      }
    }
  }
}
