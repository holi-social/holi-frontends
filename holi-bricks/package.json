    "@storybook/addon-controls": "^8.5.8",
    "@storybook/addon-essentials": "^8.5.8",
    "@storybook/addon-links": "^8.5.8",
    "@storybook/addon-ondevice-actions": "^8.5.5",
    "@storybook/addon-ondevice-backgrounds": "^8.5.5",
    "@storybook/addon-ondevice-controls": "^8.5.5",
    "@storybook/addon-ondevice-notes": "^8.5.5",
    "@storybook/addon-react-native-web": "^0.0.29",
