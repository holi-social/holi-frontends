{
  "name": "holi-bricks",
  "version": "0.0.1",
  "main": "index.ts",
  "license": "MIT",
  "scripts": {
    "eas-build-pre-install": "corepack enable",
    "web": "storybook dev -p 6006 -c storybook --debug-webpack",
    "build": "storybook build -c storybook",
    "storybook-generate": "sb-rn-get-stories --config-path ondevice",
    "storybook": "cross-env STORYBOOK_ENABLED='true' expo start -c storybook",
    "build_ios": "npx eas-cli build --profile development-simulator --platform ios",
    "build_android": "npx eas-cli build --profile development-simulator --platform android",
    "ios": "cross-env STORYBOOK_ENABLED='true' expo start --ios",
    "android": "cross-env STORYBOOK_ENABLED='true' expo start --android",
    "clean": "npx rimraf storybook-static",
    "clean:all": "yarn clean && npx rimraf node_modules",
    "lint": "TIMING=1 eslint .",
    "publish-library": "npx chromatic --ci -b build --storybook-config-dir storybook --project-token $CHROMATIC_BRICKS_PROJECT_TOKEN --exit-zero-on-changes"
  },
  "peerDependencies": {
    "@react-native-community/datetimepicker": "8.0.1",
