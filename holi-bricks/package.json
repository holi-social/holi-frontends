{
  "name": "holi-bricks",
  "version": "0.0.1",
  "main": "storybook/mobile/index.ts",
  "license": "MIT",
  "scripts": {
    "eas-build-pre-install": "corepack enable",
    "web": "storybook dev -p 6006 -c storybook/web",
    "build": "storybook build -c storybook/web",
    "storybook-generate": "sb-rn-get-stories --config-path storybook/mobile",
    "storybook": "expo start",
    "build_ios": "npx eas-cli build --profile development-simulator --platform ios",
    "build_android": "npx eas-cli build --profile development-simulator --platform android",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "clean": "npx rimraf storybook-static",
    "clean:all": "yarn clean && npx rimraf node_modules",
    "lint": "TIMING=1 eslint .",
    "publish-library": "npx chromatic --ci -b build --storybook-config-dir storybook/web --project-token $CHROMATIC_BRICKS_PROJECT_TOKEN --exit-zero-on-changes"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.25.7",
    "@expo/metro-runtime": "~6.1.2",
    "@gorhom/bottom-sheet": "^4.6.4",
    "@storybook/addon-a11y": "9.1.16",
    "@storybook/addon-docs": "9.1.16",
    "@storybook/addon-links": "9.1.16",
    "@storybook/addon-ondevice-actions": "^9.1.4",
    "@storybook/addon-ondevice-backgrounds": "^9.1.4",
    "@storybook/addon-ondevice-controls": "^9.1.4",
    "@storybook/addon-ondevice-notes": "^9.1.4",
    "@storybook/addon-react-native-web": "^0.0.29",
    "@storybook/addon-webpack5-compiler-babel": "^3.0.3",
    "@storybook/core": "^8.6.14",
    "@storybook/react-native": "9.1.4",
    "@storybook/react-webpack5": "9.1.16",
    "@testing-library/react": "^16.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "^19.2.4",
    "babel-loader": "^8.2.3",
    "babel-plugin-react-docgen-typescript": "^1.5.1",
    "babel-plugin-react-native-web": "^0.21.2",
    "chromatic": "^13.3.4",
    "eslint": "^8.33.0",
    "eslint-plugin-storybook": "9.1.16",
    "storybook": "9.1.16",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "tty-browserify": "^0.0.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@holi/icons": "*",
    "@holi/ui": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.5.0",
    "@react-native-community/slider": "5.1.1",
    "expo": "54.0.23",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.16",
    "expo-font": "~14.0.9",
    "expo-image": "~3.0.10",
    "expo-web-browser": "~15.0.9",
    "next": "^14.2.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.29.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.14.0",
    "react-native-unistyles": "^2.11.0",
    "react-native-web": "^0.21.2"
  }
}
