{
  "expo": {
    "name": "holiBricks",
    "slug": "holi-bricks",
    "version": "0.0.1",
    "sdkVersion": "52.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "social.holi.holibricks"
    },
    "ios": {
      "bundleIdentifier": "social.holi.holibricks",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "68fea4c8-87ed-40e9-a820-e3785a260a66"
      }
    },
    "owner": "holistic-foundation",
    "plugins": [
      [
        "expo-web-browser",
        "expo-font",
        {
          "fonts": [
            "components/text/fonts/InstrumentSans-Regular.ttf",
            "components/text/fonts/InstrumentSans-Medium.ttf"
          ]
        }
      ]
    ]
  }
}