{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "mobile": ["apps/mobile"],
      "web": ["apps/web"],
      "shared": ["packages/shared"],
    },
    "jsx": "preserve",
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,
    "lib": [
      "DOM",
      "ESNext",
      "dom.iterable",
    ],
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext"
  },
}