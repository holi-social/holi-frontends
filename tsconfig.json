{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@holi/mobile": ["apps/mobile"],
      "@holi/web": ["apps/web"],
      "@holi/shared": ["packages/shared"],
      "@holi/holi-apps": ["holi-apps/"]
    },
    "jsx": "preserve",
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,
    "lib": [
      "DOM",
      "ESNext",
      "dom.iterable",
    ],
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext"
  },
}