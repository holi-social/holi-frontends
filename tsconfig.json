{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@holi/mobile/*": ["apps/mobile/*"],
      "@holi/storybook/*": ["apps/storybook/*"],
      "@holi/web/*": ["apps/web/*"],
      "@holi/ui/*": ["packages/ui/*"],
      "@holi/icons/*": ["packages/icons/*"],
      "@holi/api/*": ["packages/api/*"],
      "@holi/chat/*": ["packages/chat/*"],
      "@holi/core/*": ["core/*"],
      "@holi-apps/donations/*": ["holi-apps/donations/*"],
      "@holi-apps/goodnews/*": ["holi-apps/goodnews/*"],
      "@holi-apps/volunteering/*": ["holi-apps/volunteering/*"],
      "@holi-apps/challenges/*": ["holi-apps/challenges/*"],
      "@holi/e2e-mobile/*": ["e2e/mobile/*"],
      "@holi/e2e-web/*": ["e2e/web/*"],
      "holi-bricks/*": ["holi-bricks/*"]
    },
    "jsx": "preserve",
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,
    "lib": ["DOM", "ESNext", "dom.iterable"],
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "isolatedModules": true,
    "incremental": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "typeRoots": ["./@types", "packages/ui/@types", "./node_modules/@types"],
  "extends": "expo/tsconfig.base"
}
