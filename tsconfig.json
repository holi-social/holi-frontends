{
  "compilerOptions": {
    "baseUrl": ".",
    "rootDirs": [
      "web",
      "shared",
      "mobile"
    ],
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,
    "lib": [
      "DOM",
      "ESNext",
      "dom.iterable",
    ],
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext"
  },
}