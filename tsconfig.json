{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@holi/mobile": ["apps/mobile"],
      "@holi/storybook": ["apps/storybook"],
      "@holi/web": ["apps/web"],
      "@holi/ui": ["packages/ui"],
      "@holi/api": ["packages/api"],
      "@holi/core": ["core"],
      "@holi/holi-apps": ["holi-apps/"],
      "@holi/e2e-mobile": ["e2e/mobile"],
      "@holi/e2e-web": ["e2e/web"]
    },
    "jsx": "preserve",
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,
    "lib": ["DOM", "ESNext", "dom.iterable"],
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "isolatedModules": true,
    "incremental": true
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
