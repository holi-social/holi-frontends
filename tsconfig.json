{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@holi/mobile": [
        "apps/mobile"
      ],
      "@holi/web": [
        "apps/web"
      ],
      "@holi/ui": [
        "packages/ui"
      ],
      "@holi/styles": [
        "packages/styles"
      ],
      "@holi/api": [
        "packages/api"
      ],
      "@holi/assets": [
        "packages/core"
      ],
      "@holi/core": [
        "core"
      ],
      "@holi/holi-apps": [
        "holi-apps/"
      ]
    },
    "jsx": "preserve",
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,
    "lib": [
      "DOM",
      "ESNext",
      "dom.iterable",
    ],
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "isolatedModules": true,
    "incremental": true,
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
  ],
}