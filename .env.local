# Configuration file containing e.g. backend URLs, **no secrets**. Use .envrc.local for secrets.

# depending on the execution environment, DEV_HOST must use a different value for the frontend to be able to connect to the backends
# - for web and iOS simulator use "localhost" or actual ip address (host) (platform-specific)
# - for real device use local ip address (host) (platform-specific)
# - for Android emulator use 10.0.2.2
#export DEV_HOST=$(ipconfig getifaddr en0) # macOS
#export DEV_HOST=hostname -I # Linux
export DEV_HOST=localhost
#export DEV_HOST=10.0.2.2

# Mobile and Web Backend
export ENVIRONMENT_ID=local
export ORY_BASE_URL=https://dev-auth.holi.social

export HOLI_API_URL=http://${DEV_HOST}:4455/graphql
export HOLI_API_GATEWAY=http://${DEV_HOST}:4455
export HOLI_NEXTJS_API_URL=http://${DEV_HOST}:3000

export OWNCLOUD_BASE_URL=https://local.cloud.holi.social:9200
export JITSI_URL=https://development.meet.holi.social

export HOLI_CHAT_SERVER_NAME=local.chat.holi.social
export HOLI_CHAT_SERVER_URL=http://local.chat.holi.social:8008
export HOLI_CHAT_PUSH_GATEWAY_URL=http://chat-push-gateway:5000 # synapse communicates with the push gateway via docker-compose internal network

# Web - Next.JS environment variables *statically* available to use in the frontend
export NEXT_PUBLIC_ORY_BASE_URL=https://dev-auth.holi.social

export NEXT_PUBLIC_HOLI_API_GATEWAY=http://${DEV_HOST}:3000
export NEXT_PUBLIC_HOLI_API_URL=http://${DEV_HOST}:3000/api/graphql

export NEXT_PUBLIC_OWNCLOUD_BASE_URL=https://local.cloud.holi.social:9200
export NEXT_PUBLIC_JITSI_URL=https://development.meet.holi.social

export NEXT_PUBLIC_HOLI_CHAT_SERVER_NAME=local.chat.holi.social
export NEXT_PUBLIC_HOLI_CHAT_SERVER_URL=http://local.chat.holi.social:8008
export NEXT_PUBLIC_HOLI_CHAT_PUSH_GATEWAY_URL=http://chat-push-gateway:5000 # synapse communicates with the push gateway via docker-compose internal network

export SENTRY_IGNORE_API_RESOLUTION_ERROR="1"
export SENTRY_DSN=https://0e50481f84454f9a838a8217085498f0@o949544.ingest.sentry.io/6377191