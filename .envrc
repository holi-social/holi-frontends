#!/bin/sh

export ENVIRONMENT_ID=local

export ORY_BASE_URL=https://dev-auth.holi.social
export HOLI_API_GATEWAY=https://staging.unified.apis.holi.social
export HOLI_API_URL=https://staging.unified.apis.holi.social/graphql
export OWNCLOUD_BASE_URL=https://development.cloud.holi.social
export JITSI_URL=https://development.meet.holi.social
export HOLI_CHAT_SERVER_NAME=staging.chat.holi.social
export HOLI_CHAT_SERVER_URL=https://staging.chat.holi.social/
export HOLI_CHAT_IDENTITY_SERVER_URL=https://vector.im

export NEXT_PUBLIC_ORY_BASE_URL=https://dev-auth.holi.social
export NEXT_PUBLIC_HOLI_API_GATEWAY=https://staging.unified.apis.holi.social
export NEXT_PUBLIC_HOLI_API_URL=https://staging.unified.apis.holi.social/graphql
export NEXT_PUBLIC_OWNCLOUD_BASE_URL=https://development.cloud.holi.social
export NEXT_PUBLIC_JITSI_URL=https://development.meet.holi.social
export NEXT_PUBLIC_HOLI_CHAT_SERVER_NAME=staging.chat.holi.social
export NEXT_PUBLIC_HOLI_CHAT_SERVER_URL=https://staging.chat.holi.social/
export NEXT_PUBLIC_HOLI_CHAT_IDENTITY_SERVER_URL=https://vector.im

export SENTRY_IGNORE_API_RESOLUTION_ERROR=1

if [ ! -f ".envrc.local" ]; then
  cp .envrc.local.template .envrc.local
  echo ".envrc.local was created from template, please add your credentials and customize to your environment"
fi

# loads personal (secret) data from separate env file (not checked in)
source_env_if_exists .envrc.local

type yarn >/dev/null 2>&1 && PATH="$PATH:$(yarn global bin)"
export PATH