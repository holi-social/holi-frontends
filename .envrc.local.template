#!/bin/sh

# template file, copy it to '.envrc.local' and adjust for your personal configuration
# the '.envrc.local' file is to be included by .envrc and can contain personal secrets or configuration so it is NOT TO BE CHECKED IN

# you can set you default DEV_ENV here, if you don't want to use staging by default
# this is used by direnv, when entering the frontend directory in a shell
export MY_DEFAULT_DEV_ENV=

# valid (prepared) values: 'staging' | 'local' | 'production'
# will result in loading `.env.${DEV_ENV}`
export DEV_ENV="${DEV_ENV:-${MY_DEFAULT_DEV_ENV:-staging}}"

if [ ! -f ".env.${DEV_ENV}" ]; then
  echo
  echo "Environment file \".env.${DEV_ENV}\" could not be found!"
  echo
  exit 1
else
  echo
  echo "Loading environment \"${DEV_ENV}\""
  echo
  . "./.env.${DEV_ENV}"
fi

# e2e tests
export E2E_USER_USERNAME=
export E2E_USER_PASSWORD=
export E2E_USER_ID=
export BROWSERSTACK_USERNAME=
export BROWSERSTACK_ACCESS_KEY=
export E2E_ANDROID_VIRTUAL_DEVICE_NAME="e2e_avd"
if [ "$(uname)" = "Darwin" ]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
else
  export ANDROID_HOME="$HOME/Android/Sdk"
fi
export SENTRY_AUTH_TOKEN=
export EXPO_PROJECT_ID=
export ORY_ADMIN_ACCESS_TOKEN=
export NEXT_PUBLIC_IMAGEKIT_URL=
export NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=

# For graphql codegen - decide which schema to generate from, either staging (default) or e.g. http://localhost:4455/graphql
export UNIFIED_API_SCHEMA_ENDPOINT=https://staging.unified.apis.holi.social/graphql
