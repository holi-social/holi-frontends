{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    ":enableVulnerabilityAlertsWithLabel('renovatebot/security')",
    ":semanticCommits",
    ":automergePatch",
    ":automergeTesters",
    ":automergeLinters",
    "npm:unpublishSafe",
    ":approveMajorUpdates"
  ],
  "configMigration": true,
  "prConcurrentLimit": 5,
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchSourceUrls": [
        "https://github.com/expo/expo"
      ],
      "matchPackageNames": [
        "@expo/vector-icons",
        "@stripe/stripe-react-native",
        "jest-expo",
        "lottie-react-native",
        "react",
        "react-dom",
        "@sentry/react-native",
        "@shopify/react-native-skia",
        "@sentry/react-native",
        "/^@react-native/",
        "/^react-native/"
      ],
      "groupName": "Expo managed dependencies",
      "enabled": false
    }
  ]
}