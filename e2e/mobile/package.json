{
  "dependencies": {
    "@faker-js/faker": "^8.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "webdriverio": "^7.30.1",
    "eslint": "^8.33.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-native": "^4.1.0"
  },
  "name": "@holi/e2e-mobile",
  "private": true,
  "scripts": {
    "test": "jest",
    "clean": "npx rimraf output",
    "clean:all": "yarn clean && npx rimraf node_modules",
    "format": "yarn biome format --write",
    "format:check": "yarn biome format",
    "lint": "TIMING=1 eslint .",
    "prepare:android": "./scripts/prepare_android.sh",
    "test:android": "APPIUM_TARGET=local APPIUM_PLATFORM=android yarn run jest --runInBand",
    "test:android:smoke": "APPIUM_TARGET=local APPIUM_PLATFORM=android yarn run jest --testPathPattern=/smoke/ --runInBand",
    "test:ios": "APPIUM_TARGET=local APPIUM_PLATFORM=ios yarn run jest --runInBand",
    "test:ios:smoke": "APPIUM_TARGET=local APPIUM_PLATFORM=ios LOCAL_IOS_SIMULATOR_UDID=$(xcrun simctl list devices | grep \"(Booted)\" | grep -E -o -i \"([0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12})\") yarn run jest --testPathPattern=/smoke/ --runInBand"
  },
  "version": "0.1.0"
}
