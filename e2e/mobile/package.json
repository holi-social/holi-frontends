{
  "name": "@holi/e2e-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:ios": "APPIUM_TARGET=local APPIUM_PLATFORM=ios LOCAL_IOS_SIMULATOR_UDID=$(xcrun simctl list devices | grep \"(Booted)\" | grep -E -o -i \"([0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12})\") yarn run jest --runInBand",
    "test:android": "APPIUM_TARGET=local APPIUM_PLATFORM=android yarn run jest --runInBand",
    "lint": "TIMING=1 eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "clean": "rimraf output",
    "clean:all": "yarn clean && rimraf node_modules",
    "prepare:android": "./scripts/prepare_android.sh"
  },
  "devDependencies": {
    "webdriverio": "^7.16.16"
  },
  "dependencies": {
    "@faker-js/faker": "^7.5.0"
  }
}
